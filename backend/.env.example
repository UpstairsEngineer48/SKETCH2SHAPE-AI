# Path to the official VAST-AI-Research/TripoSR checkout.
# Defaults to backend/vendor/TripoSR
# TRIPOSR_REPO=C:/path/to/TripoSR

# TripoSR inference settings
TRIPOSR_MODEL_ID=stabilityai/TripoSR
TRIPOSR_CHUNK_SIZE=4096
MESH_RESOLUTION=256
OUTPUT_FORMAT=glb
SKETCH2SHAPE_OUTPUT_DIR=./outputs
MAX_UPLOAD_MB=15
REMOVE_BACKGROUND_UPLOADS=1

# Optional Stable Diffusion + Canny ControlNet refinement.
# Keep disabled for the initial, lighter image-to-3D path.
CONTROLNET_ENABLED=0
CONTROLNET_MODEL_ID=lllyasviel/sd-controlnet-canny
SD_BASE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
CONTROLNET_STEPS=20
CONTROLNET_GUIDANCE=7.0
CONTROLNET_STRENGTH=0.85
CONTROLNET_SEED=42

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
